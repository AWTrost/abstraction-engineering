{
  "name": "@agent-class/release-review",
  "version": "0.2.0",
  "description": "An agent-class that reports planned-vs-shipped gaps for a release. Read only.",
  "type": "module",
  "bin": {
    "release-review": "bin/release-review.js"
  },
  "exports": {
    ".": {
      "types": "./dist/release-review/review.d.ts",
      "default": "./dist/release-review/review.js"
    },
    "./class.json": "./class.json"
  },
  "files": [
    "bin",
    "dist",
    "class.json",
    "prompts",
    "conformance",
    "skill",
    "setup.example.json",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "node --test \"test/*.test.ts\"",
    "check": "npm run typecheck && npm run build && git diff --exit-code -- dist && npm test"
  },
  "engines": {
    "node": ">=20"
  },
  "private": true,
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "7.0.2"
  }
}
