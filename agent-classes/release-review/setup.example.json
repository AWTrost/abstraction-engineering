{
  "name": "my-team",
  "class": "release-review@0.2.1",
  "fix_version": "{release}",
  "bindings": {
    "planned_tickets": {"cmd": ["node", "bindings/tickets.js", "planned", "{release}"]},
    "tickets": {"cmd": ["node", "bindings/tickets.js", "keys"]},
    "release_changes": {"cmd": ["node", "bindings/changes.js", "{release}"]},
    "change_matches_ticket": {"model": "haiku"}
  },
  "status_map": {
    "To Do": "todo",
    "In Progress": "in_progress",
    "Ready for QA": "awaiting_qa",
    "In QA": "in_qa",
    "Done": "done"
  },
  "expected_states": ["awaiting_qa", "in_qa"],
  "report_dir": "release-reviews",
  "signoff": "the release owner"
}
